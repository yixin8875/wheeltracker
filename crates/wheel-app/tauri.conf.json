{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wheel Tracker",
  "version": "0.5.4",
  "identifier": "com.wheeltracker.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wheel Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "publisher": "Wheel Tracker contributors",
    "copyright": "Copyright © 2026 Wheel Tracker contributors",
    "category": "Finance",
    "shortDescription": "Wheel strategy cost-basis ledger",
    "longDescription": "Local-first desktop ledger for US options wheel strategy cost basis, premium, assignments, splits, income and annual reports.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Wheel Tracker",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2N0FEMDRFMDZDQ0I0QTUKUldTbHRNd0dUdEI2NW8yUEg3UC9uQndNQmxMWGRJb0daY0JOVnBnS29qQzRabzcySW9La3AwSEUK",
      "endpoints": [
        "https://github.com/yixin8875/wheeltracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
